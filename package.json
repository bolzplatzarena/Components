{
  "name": "bolzplatzarena-components",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "npm run build-lib && ng build",
    "watch": "ng build --watch --configuration development",
    "test-component": "jest --coverage --config ./projects/components/jest.config.js",
    "tailwind": "npx tailwindcss build -o ./projects/styles/tailwind.scss -c ./tailwind.lib.config.js",
    "tailwind-ng": "npx tailwindcss build -o ./src/styles/tailwind.scss -c ./tailwind.config.js",
    "lib": "ng build components",
    "debug": "npm run tailwind && npm run tailwind-ng && ng build components && ng serve",
    "build-lib": "npm run tailwind && ng build components",
    "lint": "ng lint",
    "depcheck": "npx depcheck",
    "publish": "npm run build-lib && cd dist/@bolzplatzarena/components && npm publish"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.3.0",
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/material": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/platform-browser-dynamic": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@fortawesome/angular-fontawesome": "^5.1.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@ngx-translate/core": "^18.1.0",
    "rxjs": "~7.8.2",
    "tailwindcss": "^3.4.19",
    "tslib": "^2.9.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@eslint/js": "^10.0.1",
    "@types/jasmine": "~7.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "angular-cli-ghpages": "^3.1.2",
    "angular-eslint": "^22.8.0",
    "eslint": "^10.15.0",
    "eslint-plugin-function-name": "^2.0.5",
    "jasmine-core": "~7.0.2",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-preset-angular": "^17.0.3",
    "prettier": "3.10.1",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
